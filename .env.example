# ---- Login com MFA (banco PostgreSQL próprio, ex.: Neon) ----
# Connection string do painel do Neon (com sslmode=require). Rode `npm run migrate` depois de definir.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Segredo que assina a sessão e os códigos MFA (mínimo 32 caracteres aleatórios; NÃO reutilize o de outro sistema).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Envio do código MFA por e-mail (SMTP). Sem isso, o login não funciona em produção.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Controle de estoque RTT <usuario@rttshop.com.br>
# Alternativa ao SMTP: se SMTP_HOST estiver vazio e houver RESEND_API_KEY, usa o Resend.
RESEND_API_KEY=
# Domínios de e-mail permitidos para criar usuários (separados por vírgula).
ALLOWED_EMAIL_DOMAINS=rttshop.com.br
# Primeiro administrador (usado apenas por `npm run migrate`, se ainda não houver administrador).
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# ---- Fonte dos dados (consulta do consultor Protheus / fluxo n8n) ----
# URL que devolve o JSON de dados (formato de docs/especificacao_dados_consultor.md ou o formato interno).
SOURCE_URL=
# Token enviado como "Authorization: Bearer ..." ao chamar a fonte (opcional).
SOURCE_TOKEN=
# GET (padrao) ou POST
SOURCE_METHOD=GET

# ---- Seguranca ----
# Token de MÁQUINA (n8n empurrando dados via PUT /api/dados, com "Authorization: Bearer ..."). Pessoas usam o login.
ADMIN_TOKEN=
# Segredo usado pelo agendador da Netlify para disparar a atualizacao.
CRON_SECRET=

# ---- Texto exibido no painel (apenas informativo) ----
SCHEDULE_LABEL=07:00, 12:00 e 17:00 (seg a sab)

